{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AzureBlobStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "LS_Azure_SQL",
						"type": "LinkedServiceReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureBlobStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ClaimID as short,",
				"          CustomerName as string,",
				"          ClaimAmount as integer,",
				"          ClaimStatus as string,",
				"          ClaimDate as date",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 100,",
				"     ignoreNoFilesFound: false,",
				"     purgeFiles: true,",
				"     rowUrlColumn: 'source_file',",
				"     format: 'delimited',",
				"     container: 'landing',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     wildcardPaths:['sales/*.csv']) ~> source1",
				"source1 derive(ClaimStatus = upper(ClaimStatus)) ~> derivedColumn1",
				"derivedColumn1 filter(ClaimStatus == 'APPROVED' && ClaimAmount > 50000) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'tbl_Claims',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     stagingSchemaName: 'dbo',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     outputRejectedData: true,",
				"     outputAssertFailedRows: true,",
				"     assertFailure_container: 'landing',",
				"     assertFailure_folderPath: 'error',",
				"     mapColumn(",
				"          ClaimID,",
				"          CustomerName,",
				"          ClaimAmount,",
				"          ClaimStatus,",
				"          ClaimDate,",
				"          source_file",
				"     )) ~> sink1"
			]
		}
	}
}